# Copy to .env for local development. dotenv-rails loads it automatically; Git ignores it.
# New conversations default to openai or gemini. You can also choose in each workspace.
CHAT_PROVIDER=openai

# Native Google Gemini; GEMINI_MODEL defaults to gemini-2.5-flash when unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI or a streaming Chat Completions-compatible endpoint.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

PCSX2_EXECUTABLE=
PCSX2_BIOS_PATH=
