<% content_for :title, "#{@game_image.name} · PS2 Games Lab" %>
<% messages = @game_image.messages.order(:created_at, :id).to_a %>
<% streaming = %w[pending importing].include?(@game_image.status) || @game_image.launch_status == "launching" || messages.any? { |message| message.status == "pending" } %>
<% last_reply = messages.reverse.find { |message| message.role == "assistant" && message.provider.present? && message.model_id.present? } %>
<% selected_provider = last_reply&.provider || ChatProvider.default %>
<% selected_model = last_reply&.model_id || ChatProvider.default_model(selected_provider) %>
<% provider_models = ChatProvider::LABELS.keys.index_with { |provider| ChatProvider.default_model(provider) } %>
<% provider_notices = ChatProvider::LABELS.keys.index_with { |provider| ChatProvider.configuration_error(provider: provider, model: "configured-model") } %>
<% launch_configured = ENV["PCSX2_EXECUTABLE"].present? && ENV["PCSX2_BIOS_PATH"].present? %>
<% reply_pending = messages.any? { |message| message.status == "pending" } %>
<div data-controller="refresh provider" data-refresh-active-value="<%= streaming %>" data-refresh-url-value="<%= events_game_image_path(@game_image) %>" data-provider-models-value="<%= provider_models.to_json %>" data-provider-notices-value="<%= provider_notices.to_json %>" data-action="provider:restore->provider#restore turbo:load@document->refresh#restoreScroll">
  <%= link_to "← Library", root_path, class: "text-link back-link" %>
  <section class="page-heading game-heading" aria-labelledby="game-heading">
    <div><p class="eyebrow">Game hub · PlayStation 2</p><h1 id="game-heading"><%= @game_image.name %></h1></div>
    <span class="status status-<%= @game_image.status %>"><%= @game_image.status.humanize %></span>
  </section>
  <% if %w[pending importing].include?(@game_image.status) %>
    <div class="notice" role="status">Import in progress. Your ISO is being copied and hashed in the background. This page updates automatically.</div>
  <% end %>
  <% if @game_image.error.present? %>
    <div class="notice notice-error" role="alert">Import failed: <%= @game_image.error %></div>
  <% end %>
  <div class="game-layout">
      <section class="panel playback-panel" aria-labelledby="launch-heading">
        <div class="playback-heading"><h2 id="launch-heading">Playback</h2><span class="muted">Launch status: <%= @game_image.launch_status.humanize %></span></div>
        <p>Launch this original in a separate PCSX2 desktop window on the computer running Rails.</p>
        <% unless launch_configured %>
          <div class="notice">Set <code>PCSX2_EXECUTABLE</code> and <code>PCSX2_BIOS_PATH</code> to your installed emulator and legally supplied BIOS, then restart Rails.</div>
        <% end %>
        <%= button_to "Launch original", game_image_launch_path(@game_image), class: "button button-primary", disabled: !@game_image.ready? || !launch_configured, data: { turbo: false } %>
        <p class="fine-print">A process launch does not confirm game boot or gameplay.</p>
        <% if @game_image.launch_error.present? %><p class="error-text" role="alert"><%= @game_image.launch_error %></p><% end %>
      </section>

    <%= render "game_images/settings", launch_configured: launch_configured %>
    <details class="panel conversation" data-refresh-target="conversation">
      <summary class="conversation-header" id="conversation-heading">Optional AI assistant · conversation</summary>
      <p class="conversation-disclosure">Your next message, prior completed conversation history, and image metadata (name, size, hash) go to <strong data-provider-target="label"><%= ChatProvider::LABELS[selected_provider] || "the selected provider" %></strong>. Switching vendors transfers that history to the newly selected vendor. ISO bytes are not sent. Chat does not modify your image.</p>
      <div class="messages" data-refresh-target="messages" aria-live="polite" aria-relevant="additions text">
        <%= render "game_images/messages", messages: messages %>
      </div>
      <%= form_with url: game_image_messages_path(@game_image), data: { action: "submit->refresh#prepareSubmission" }, class: "chat-form" do |form| %>
        <div class="provider-fields">
          <div>
            <%= form.label :provider, "AI provider" %>
            <%= form.select :provider, ChatProvider::LABELS.map { |provider, label| [label, provider] }, { selected: selected_provider }, required: true, aria: { describedby: "provider-notice" }, data: { provider_target: "provider", refresh_target: "provider", action: "change->provider#change" } %>
          </div>
          <div>
            <%= form.label :model, "Model ID" %>
            <%= form.text_field :model, value: selected_model, required: true, maxlength: 200, placeholder: "Exact provider model ID", data: { provider_target: "model", refresh_target: "model" } %>
          </div>
        </div>
        <p id="provider-notice" class="notice provider-notice" data-provider-target="notice" role="status" aria-live="polite" <%= "hidden" if provider_notices[selected_provider].blank? %>><%= provider_notices[selected_provider] %></p>
        <%= form.label :content, "Your message" %>
        <%= form.text_area :content, rows: 4, required: true, maxlength: 4000, placeholder: "Ask about this game or PCSX2…", data: { refresh_target: "draft" } %>
        <div class="composer-footer">
          <span class="fine-print"><%= @game_image.ready? ? "AI answers may be inaccurate. Verify important advice." : "Chat is available after a successful import." %></span>
          <%= form.submit "Send message", class: "button button-primary", disabled: !@game_image.ready? || reply_pending %>
        </div>
      <% end %>
    </details>
    <div class="workspace-details">
      <details class="panel original-details">
        <summary id="image-heading">Original image · <%= @game_image.byte_size.present? ? number_to_human_size(@game_image.byte_size) : "Size pending" %> · Read-only</summary>
        <div class="setup-instructions">
        <p>The managed original is read-only. Import never changes your source file, and this chat cannot write to the image.</p>
        <dl class="image-metadata">
          <dt>Size</dt><dd><%= @game_image.byte_size.present? ? number_to_human_size(@game_image.byte_size) : "Pending" %></dd>
          <dt>SHA-256</dt><dd class="hash"><%= @game_image.sha256.presence || "Calculated during import" %></dd>
          <dt>Import status</dt><dd><%= @game_image.status.humanize %></dd>
        </dl>
        </div>
      </details>
      <%= render "game_images/dualsense_setup" %>
    </div>
  </div>
</div>
