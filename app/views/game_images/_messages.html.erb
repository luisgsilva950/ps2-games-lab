<% if messages.empty? %><div class="chat-empty"><h3>Start with a question.</h3><p>Explore your game, discuss an idea, or ask about PCSX2. This workflow supports conversation, not binary patches.</p></div><% end %>
<% messages.each do |message| %>
  <article class="message message-<%= message.role %>">
    <div class="message-heading"><strong><%= message.role == "user" ? "You" : "Assistant" %></strong><span class="muted"><%= message.status.humanize %></span></div>
    <% if message.content.present? %><div class="message-content"><%= message.content %></div><% end %>
    <% if message.status == "pending" %><p class="muted"><%= message.content.present? ? "Receiving response…" : "Waiting for the model response…" %></p><% end %>
    <% if message.status == "failed" %><p class="error-text">Response failed. <%= message.error %></p><% end %>
  </article>
<% end %>
