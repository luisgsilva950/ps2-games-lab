<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "PS2 Games Lab" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="PS2 Games Lab">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <%= link_to root_path, class: "brand" do %>
        <span class="console-mark" aria-hidden="true">PS2</span>
        <span>Games <strong>Lab</strong></span>
      <% end %>
      <nav class="header-nav" aria-label="Main navigation">
        <%= link_to "Library", root_path, aria: { current: current_page?(root_path) ? "page" : nil } %>
        <span class="local-badge">Local console</span>
      </nav>
    </header>
    <main id="main" class="workspace" tabindex="-1">
      <% flash.each do |type, message| %>
        <div class="notice <%= type == "alert" ? "notice-error" : "" %>" role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="site-footer">Your images stay local. PCSX2 runs in its own desktop window.</footer>
  </body>
</html>
